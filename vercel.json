{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://aman-portfolio-api.onrender.com/api/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://aman-portfolio-api.onrender.com/ws/:path*"
    },
    { "source": "/((?!api/|ws/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(favicon.svg|site.webmanifest|og-image.jpg|og-background.webp)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
